{
  "name": "inpagerun",
  "version": "0.9.2",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "bin": {
    "inpagerun": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/test.ts"
  },
  "scripts": {
    "build": "smartbundle",
    "fmt": "oxfmt .",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:types": "tsc --noEmit",
    "test:fmt": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "chai": "^6.2.2",
    "commander": "^15.0.0",
    "playwright": "1.61.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "simple-git-hooks": "^2.13.1",
    "smartbundle": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm fmt && pnpm test:types"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  }
}
