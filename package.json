{
  "name": "inpagerun",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "bin": {
    "inpagerun": "./src/cli.ts"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "smartbundle",
    "fmt": "oxfmt .",
    "test:types": "tsc --noEmit",
