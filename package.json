  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxfmt": "^0.53.0",
    "simple-git-hooks": "^2.13.1",
    "smartbundle": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm fmt && pnpm test:types"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  }
